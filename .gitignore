# ============================================
# SkillHive - Root Git Ignore
# ============================================

# Environment variables / secrets
.env
.env.*
!.env.example

# Python virtual environment
.venv/
venv/
env/
ENV/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Django
db.sqlite3
*.log
staticfiles/

# User-uploaded media
media/

# Node / React / Vite
node_modules/
dist/
dist-ssr/
build/
.vite/

# Node package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# IDE / Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Testing / coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.mypy_cache/

# Python packaging
*.egg-info/
.eggs/
pip-wheel-metadata/

# Cache
*.cache

# Local ESCO dataset / temporary data
esco_new/